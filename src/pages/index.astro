---
// ✅ root branch edit — Discord worktree system works!
import '../styles/global.css'
import { Image } from 'astro:assets'
import logo from '../assets/logo.webp'
import logoFull from '../assets/logo-full.webp'

const socials = [
  { name: "YouTube", url: "https://www.youtube.com/@fabianshaw_/videos", icon: "youtube" },
  { name: "Instagram", url: "https://www.instagram.com/fabianshaw_/", icon: "instagram" },
  { name: "X", url: "https://x.com/fabianshaw_", icon: "twitter" }
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Solve Your Trading Execution Errors By Overcoming Mental Biases, Implement Proper Risk Management. Train With Fabian, and Reach Your Full Potential as a Trader" />
    <meta name="theme-color" content="#050508" />
    <title>Trading Sauce - Trading Courses With Fabian Shaw</title>
  </head>

  <body class="cyber-grid min-h-screen">
    <!-- Ambient Glow -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-1/4 -left-32 w-96 h-96 bg-cyan/5 rounded-full blur-[128px]"></div>
      <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-magenta/5 rounded-full blur-[128px]"></div>
    </div>

    <!-- Header -->
    <header class="sticky sm:fixed top-0 left-0 right-0 z-50 bg-void/80 backdrop-blur-md border-b border-gunmetal/50">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-3">
          <img src="/logo.png" alt="Trading Sauce" class="w-15 h-15 object-contain" />
          <span class="font-display text-sm tracking-wider text-ghost hidden sm:block">
            Trading<span class="text-sauce">Sauce</span>
          </span>
        </a>
        <div class="flex items-center gap-3">
          <a
            href="http://futures101.tradingsauce.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-sauce text-xs"
          >
            Futures 101
          </a>
          <a
            href="https://advanced.tradingsauce.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-cyber text-xs"
          >
            Advanced
          </a>
        </div>
      </div>
    </header>

    <main class="relative">
      <!-- Hero Section -->
      <section class="min-h-screen flex items-center justify-center pt-20 px-6">
        <div class="max-w-4xl mx-auto text-center">
          <div class="mb-8">
            <span class="inline-block px-4 py-2 text-xs font-mono text-cyan border border-cyan/30 bg-cyan/5 tracking-widest uppercase">
              Trading Courses
            </span>
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-7xl font-display font-bold mb-6 leading-tight">
            <span class="text-ghost">Trading</span>
            <span class="text-sauce glow-sauce">Sauce</span>
          </h1>

          <p class="text-xl sm:text-2xl text-mist mb-4 font-display tracking-wide">
            with <span class="text-cyan">Fabian Shaw</span>
          </p>

          <p class="text-lg text-shadow max-w-2xl mx-auto mb-12 leading-relaxed">
            Create your backtested system with edge, optimise your risk management, and lock in your trading psychology.
          </p>

          <div class="flex justify-center">
            <a href="#about" class="btn-cyber text-lg px-8 py-4">
              Learn More
            </a>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="py-24 px-6">
        <div class="max-w-4xl mx-auto">
          <div class="card-cyber p-8 sm:p-12 rounded-lg">
            <div class="grid md:grid-cols-[220px,1fr] gap-8 items-start">
              <!-- Image -->
              <div class="relative group">
                <div class="aspect-square bg-dark border border-gunmetal rounded overflow-hidden">
                  <img
                    src="/fabian.png"
                    alt="Fabian Shaw"
                    class="w-full h-full object-cover object-top"
                    loading="lazy"
                  />
                  </div>
                <div class="absolute inset-0 border border-cyan/20 rounded translate-x-2 translate-y-2 -z-10 group-hover:translate-x-3 group-hover:translate-y-3 transition-transform"></div>
              </div>

              <!-- Content -->
              <div class="space-y-4">
                <h2 class="text-2xl sm:text-3xl font-display text-ghost">
                  Hey, I'm <span class="text-cyan">Fabian!</span>
                </h2>
                <p class="text-mist leading-relaxed">
                  ...Automated trader and systems builder.
                </p>
                <p class="text-mist leading-relaxed">
                  If you've been in this game for a while, spinning your wheels but gaining no traction...
                </p>
                <p class="text-ghost font-medium leading-relaxed">
                  WELCOME to the DRIVING SCHOOL of TRADING! 🏎️
                </p>
                <p class="text-mist leading-relaxed">
                  Similar to driving, there are technical skills and knowledge that <span class="text-cyan">MUST</span> be acquired.
                </p>
                <p class="text-mist leading-relaxed">
                  In trading, most people are brute forcing without any real guidance...
                </p>
                <p class="text-mist leading-relaxed">
                  And wondering why they're not seeing success. 😡
                </p>
                <p class="text-mist leading-relaxed">
                  But, after three years of trading... <span class="text-cyan">I finally cracked the code.</span>
                </p>
                <p class="text-mist leading-relaxed">
                  People focus on psychology, risk, and setups last.
                </p>
                <p class="text-mist leading-relaxed">
                  But you see... That is an absolute recipe for failure!... 😱
                </p>
                <p class="text-mist leading-relaxed">
                  No defined system... but still beating yourself up for every losing trade.
                </p>
                <p class="text-mist leading-relaxed">
                  ...Sound familiar?...
                </p>
                <p class="text-mist leading-relaxed">
                  The reality is... <span class="text-cyan">setups come first</span>... then <span class="text-cyan">risk</span>... then <span class="text-cyan">psychology.</span>
                </p>
                <p class="text-mist leading-relaxed">
                  You're not "broken," you just don't have a roadmap.
                </p>
                <p class="text-ghost font-medium leading-relaxed">
                  ...And that's where I come in. 😎
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Courses Section -->
      <section id="courses" class="py-24 px-6 bg-abyss/50">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <span class="inline-block px-4 py-2 text-xs font-mono text-sauce border border-sauce/30 bg-sauce/5 tracking-widest uppercase mb-6">
              Start Here
            </span>
            <h2 class="text-3xl sm:text-4xl font-display mb-4">
              Pick your <span class="text-sauce glow-sauce">course</span>
            </h2>
            <p class="text-mist max-w-2xl mx-auto">
              Two focused trainings. Choose your level and start now.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-8">
            <article class="card-cyber p-8 rounded-lg">
              <h3 class="text-2xl font-display text-ghost mb-4">Futures 101</h3>
              <p class="text-mist mb-8 leading-relaxed">
                Build your foundation: market structure, risk management, and execution basics.
              </p>
              <a
                href="http://futures101.tradingsauce.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-sauce inline-flex"
              >
                Start Futures 101
              </a>
            </article>

            <article class="card-cyber p-8 rounded-lg border-cyan/30">
              <h3 class="text-2xl font-display text-ghost mb-4">Advanced</h3>
              <p class="text-mist mb-8 leading-relaxed">
                Sharpen your edge, systemize execution, and scale with more precision.
              </p>
              <a
                href="https://advanced.tradingsauce.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-cyber inline-flex"
              >
                Go Advanced
              </a>
            </article>
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section id="contact" class="py-24 px-6">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl font-display mb-6">
            <span class="text-ghost">Email and</span> <span class="text-cyan">Socials</span>
          </h2>
<!-- removed -->

          <a
            href="mailto:fabian@tradingsauce.com"
            class="inline-block font-mono text-lg text-cyan hover:text-ghost transition-colors mb-12"
          >
            fabian@tradingsauce.com
          </a>

          <!-- Social Links -->
          <div class="flex justify-center gap-6">
            {socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener"
                class="w-12 h-12 border border-gunmetal hover:border-cyan flex items-center justify-center transition-colors group"
                title={social.name}
              >
                {social.icon === "youtube" && (
                  <svg class="w-5 h-5 text-mist group-hover:text-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                )}
                {social.icon === "instagram" && (
                  <svg class="w-5 h-5 text-mist group-hover:text-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                )}
                {social.icon === "twitter" && (
                  <svg class="w-5 h-5 text-mist group-hover:text-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                )}
              </a>
            ))}
          </div>

          <p class="text-sm text-shadow mt-6">
            I'm active on YouTube and Instagram. X not so much.
          </p>
        </div>
      </section>

      <!-- YouTube Section -->
      <section id="youtube" class="py-24 px-6 bg-abyss/50">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-16">
            <span class="inline-block px-4 py-2 text-xs font-mono text-sauce border border-sauce/30 bg-sauce/5 tracking-widest uppercase mb-6">
              Free Content
            </span>
            <h2 class="text-3xl sm:text-4xl font-display mb-4">
              <span class="text-ghost">On </span><span class="text-sauce glow-sauce">Youtube</span><span class="text-ghost"> and in Your </span><span class="text-sauce glow-sauce">Inbox</span>
            </h2>
            <p class="text-mist max-w-2xl mx-auto">
              I'm talking about my personal journey on YouTube and by Email.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-8 mb-12 items-stretch">
            <!-- YouTube Card -->
            <div class="card-cyber p-6 rounded-lg flex flex-col items-center text-center">
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-10 h-10 text-sauce" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                <h3 class="text-xl font-display text-ghost">@fabianshaw_</h3>
              </div>
              <p class="text-mist mb-6">
                Subscribe for:
              </p>
              <ul class="space-y-2 mb-6 text-sm text-shadow">
                <li class="flex items-center gap-2">
                  <span class="text-sauce">▹</span> Progress Updates
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-sauce">▹</span> Prop Firm Reviews
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-sauce">▹</span> Trading Lessons
                </li>
              </ul>
              <a
                href="https://www.youtube.com/@fabianshaw_/videos"
                target="_blank"
                rel="noopener"
                class="btn-cyber !border-sauce !text-sauce hover:!bg-sauce/10 inline-flex items-center gap-2 w-fit mx-auto"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                Watch All Videos
              </a>
              <p class="text-xs text-shadow mt-3">Opens in a new tab.</p>
            </div>

            <!-- Newsletter Card -->
            <div class="card-cyber p-6 rounded-lg flex flex-col items-center text-center">
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-10 h-10 text-sauce" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.236-8 4.8-8-4.8V6l8 4.8L20 6v2.236z"/>
                </svg>
                <h3 class="text-xl font-display text-ghost">Join My Newsletter</h3>
              </div>
              <p class="text-mist mb-6">
                Subscribe for:
              </p>
              <ul class="space-y-2 mb-6 text-sm text-shadow">
                <li class="flex items-center gap-2">
                  <span class="text-sauce">▹</span> Behind the Scenes Access
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-sauce">▹</span> Early Access to New Courses
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-sauce">▹</span> <span class="text-magenta">FREE "Prop Firm Risk Management" PDF</span>
                </li>
              </ul>
              <a
                href="https://tradingsauce.eo.page/newsletter"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-cyber !border-sauce !text-sauce hover:!bg-sauce/10 inline-flex items-center justify-center gap-2 w-fit mx-auto"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.236-8 4.8-8-4.8V6l8 4.8L20 6v2.236z"/>
                </svg>
                Join Newsletter
              </a>
              <p class="text-xs text-shadow mt-3">Opens in a new tab.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gunmetal py-12 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="grid sm:grid-cols-3 gap-8 mb-8">
          <div>
            <img src="/logo-full.webp" alt="Trading Sauce" class="h-48 sm:h-24 w-auto object-contain mb-6 sm:mb-4" />
            <p class="text-sm text-shadow">
              Where aspiring traders learn how to trade and grow their capital.
            </p>
          </div>
          <div>
            <h4 class="font-display text-cyan text-sm mb-3">Courses</h4>
            <ul class="space-y-2 text-sm text-shadow">
              <li><a href="http://futures101.tradingsauce.com/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">Futures 101</a></li>
              <li><a href="https://advanced.tradingsauce.com/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">Advanced</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-display text-cyan text-sm mb-3">Contact</h4>
            <a href="mailto:fabian@tradingsauce.com" class="text-sm text-mist hover:text-cyan transition-colors">
              fabian@tradingsauce.com
            </a>
          </div>
        </div>

        <div class="divider mb-8"></div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-shadow">
          <p>© Trading Sauce {new Date().getFullYear()}</p>
          <p class="font-mono text-xs">[ EXECUTE WITH PRECISION ]</p>
        </div>
      </div>
    </footer>
  </body>
</html>
